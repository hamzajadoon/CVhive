# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cvhive
NODE_ENV=development

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3001

# JWT Secrets
JWT_SECRET=your-very-long-secret-key-minimum-32-characters-for-jwt-use-something-random
JWT_REFRESH_SECRET=your-very-long-refresh-secret-key-minimum-32-characters-for-jwt-refresh

# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Email Service (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key_here

# AWS S3 (Optional - for CV storage in cloud)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=cvhive-cvs-prod

# Redis (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
